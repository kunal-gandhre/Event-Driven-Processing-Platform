terraform {  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }}provider "aws" { region = var.region }resource "aws_sns_topic" "processing_events" { name = "processing-events" }resource "aws_sqs_queue" "processing_events" { name = "processing-events" visibility_timeout_seconds = 60 }resource "aws_sqs_queue" "processing_events_dlq" { name = "processing-events-dlq" }resource "aws_sqs_queue_redrive_policy" "processing_events" {  queue_url = aws_sqs_queue.processing_events.id  redrive_policy = jsonencode({ deadLetterTargetArn = aws_sqs_queue.processing_events_dlq.arn, maxReceiveCount = 5 })}resource "aws_sqs_queue_policy" "allow_sns" {  queue_url = aws_sqs_queue.processing_events.id  policy = jsonencode({ Version = "2012-10-17", Statement = [{ Effect = "Allow", Principal = { Service = "sns.amazonaws.com" }, Action = "sqs:SendMessage", Resource = aws_sqs_queue.processing_events.arn, Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.processing_events.arn } } }] })}resource "aws_sns_topic_subscription" "queue" { topic_arn = aws_sns_topic.processing_events.arn protocol = "sqs" endpoint = aws_sqs_queue.processing_events.arn raw_message_delivery = true }resource "aws_s3_bucket" "payloads" { bucket_prefix = "event-payloads-" }output "sqs_queue_url" { value = aws_sqs_queue.processing_events.url }output "sns_topic_arn" { value = aws_sns_topic.processing_events.arn }output "s3_bucket_name" { value = aws_s3_bucket.payloads.bucket }